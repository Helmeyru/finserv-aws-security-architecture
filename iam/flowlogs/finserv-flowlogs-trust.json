{
    "Version":  "2012-10-17",
    "Statement":  [
                      {
                          "Effect":  "Allow",
                          "Principal":  {
                                            "Service":  "vpc-flow-logs.amazonaws.com"
                                        },
                          "Condition":  {
                                            "StringEquals":  {
                                                                 "aws:SourceAccount":  "123456789012"
                                                             }
                                        },
                          "Action":  "sts:AssumeRole"
                      }
                  ]
}
